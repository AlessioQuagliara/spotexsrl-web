---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { company, pecMailto } from "../../data/company.js";

const sections = [
  {
    title: "Sviluppo software",
    description:
      "Attività di progettazione e realizzazione di software su misura, orientata a supportare processi e attività operative specifiche.",
  },
  {
    title: "Piattaforme, sistemi informativi e interfacce web",
    description:
      "Sviluppo di piattaforme web e sistemi informativi, con attenzione alla chiarezza dell'interfaccia e alla struttura tecnica sottostante.",
  },
  {
    title: "Siti e portali internet",
    description:
      "Realizzazione e gestione di siti e portali internet, curati nella struttura dei contenuti e nell'organizzazione delle informazioni.",
  },
  {
    title: "Supporto tecnico e consulenza su progetti digitali",
    description:
      "Attività di supporto tecnico e consulenza a fianco di progetti digitali esistenti o in fase di definizione.",
  },
  {
    title: "Campagne di marketing e servizi pubblicitari",
    description:
      "Attività complementare di supporto alla conduzione di campagne di marketing e servizi pubblicitari digitali.",
  },
];
---

<BaseLayout
  title="Servizi digitali"
  description="Attività di programmazione informatica, sviluppo software, piattaforme web e servizi complementari legati al digitale offerte da Spotex S.r.l."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servizi</span>
        <h1>Servizi digitali</h1>
        <p class="lede">
          Spotex S.r.l. svolge attività di programmazione informatica e servizi
          complementari legati al digitale.
        </p>
      </div>

      <div class="prose">
        {
          sections.map((item) => (
            <section>
              <h2>{item.title}</h2>
              <p>{item.description}</p>
            </section>
          ))
        }
      </div>

      <div class="status-box" style="margin-top: var(--space-6);">
        <span class="status-box__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M4 6l8 6 8-6M4 6h16v12H4V6z"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <div>
          <strong>Per informazioni sui servizi</strong>
          <p>
            Per richieste o comunicazioni relative ai servizi descritti in questa pagina è
            possibile contattare {company.legalName} tramite PEC: <a
              class="text-link"
              href={pecMailto}>{company.pec}</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
