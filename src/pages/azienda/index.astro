---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { company, addressFull, pecMailto } from "../../data/company.js";
---

<BaseLayout
  title="Azienda"
  description="Spotex S.r.l. è una società con sede a Faloppio, in provincia di Como, attiva nell'ambito della programmazione informatica e dei servizi digitali."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Azienda</span>
        <h1>{company.legalName}</h1>
        <p class="lede">
          Spotex S.r.l. è una società con sede a Faloppio, in provincia di Como, attiva
          nell'ambito della programmazione informatica e dei servizi digitali.
        </p>
      </div>

      <div class="prose">
        <h2>Attività</h2>
        <p><strong>Attività prevalente:</strong> programmazione informatica e sviluppo software.</p>
        <p><strong>Attività complementare:</strong> campagne di marketing e servizi pubblicitari.</p>
      </div>

      <div class="section-head" style="margin-top: var(--space-6); margin-bottom: var(--space-3);">
        <h2 style="margin-bottom: 0;">Dati societari</h2>
      </div>
      <div class="info-card">
        <dl>
          <dt>Ragione sociale</dt>
          <dd>{company.legalName}</dd>

          <dt>Sede legale</dt>
          <dd>{addressFull}</dd>

          <dt>P. IVA / C.F.</dt>
          <dd>{company.vatTaxId}</dd>

          <dt>REA</dt>
          <dd>{company.rea}</dd>

          <dt>PEC</dt>
          <dd><a class="text-link" href={pecMailto}>{company.pec}</a></dd>
        </dl>
      </div>

      <div class="status-box" style="margin-top: var(--space-6);">
        <span class="status-box__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.75" />
            <path d="M12 10.75v6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            <circle cx="12" cy="7.6" r="1.15" fill="currentColor" />
          </svg>
        </span>
        <div>
          <strong>Stato societario: la società è in liquidazione.</strong>
          <p>
            Per comunicazioni ufficiali utilizzare la PEC indicata in questa pagina: <a
              href={pecMailto}>{company.pec}</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
